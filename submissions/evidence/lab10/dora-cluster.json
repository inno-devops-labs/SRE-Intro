                                    "while true; do\n  curl --max-time 12 -s -o /dev/null -w 'events %{http_code} %{time_total}s\\n' http://gateway:8080/events\n  RES=$(curl --max-time 12 -s -X POST http://gateway:8080/events/7808/reserve \\\n    -H 'Content-Type: application/json' -d '{\"quantity\":1}')\n  RID=$(echo \"$RES\" | sed -n 's/.*reservation_id\":\"\\([^\"]*\\).*/\\1/p')\n  if [ -n \"$RID\" ]; then\n    curl --max-time 12 -s -X POST -o /dev/null -w 'pay %{http_code} %{time_total}s\\n' \\\n      \"http://gateway:8080/reserve/$RID/pay\"\n  else\n    echo \"reserve failed: $RES\"\n  fi\n  sleep 0.3\ndone\n"
                                ],
